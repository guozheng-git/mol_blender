Bootstrap: docker
From: debian@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d

# Run from the repository root after scripts/build_release.py --output dist/release.
# Linux x86_64 only. No Mac environments or caches are copied into the image.
# Debian 13 (trixie-slim): glibc 2.41 supports the target cluster's NVIDIA libraries.
%arguments
    RELEASE_DIR=dist/release
    BUILD_PROXY=

%files
    {{ RELEASE_DIR }}/plugin/structure-studio /opt/structure-studio
    {{ RELEASE_DIR }}/release.json /opt/release.json

%post
    set -eu
    # Optional build-only proxy; never inherited by render jobs.
    if [ -n '{{ BUILD_PROXY }}' ]; then
        export http_proxy='{{ BUILD_PROXY }}' https_proxy='{{ BUILD_PROXY }}'
        export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy"
    fi
    apt-get update
    apt-get install -y --no-install-recommends python3 python3-venv ca-certificates ffmpeg \
        libxrender1 libxxf86vm1 libxfixes3 libxi6 libxkbcommon0 libsm6 libice6 \
        libgl1 libegl1 libglu1-mesa libgomp1 libx11-6 libxext6 libxinerama1 \
        libxcursor1 libxrandr2 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        libdecor-0-0 libfreetype6 libpng16-16t64 libglut3.12 libxml2 libopengl0 libglx0 libglib2.0-0t64
    python3 -m venv /opt/uv-tool
    /opt/uv-tool/bin/pip install uv==0.11.32
    export PATH=/opt/uv-tool/bin:$PATH
    export STRUCTURE_STUDIO_HOME=/opt/studio-runtime
    export BLENDER_RENDER_HOME=/opt/studio-runtime/blender-render
    python3 /opt/structure-studio/skills/structure-studio/scripts/studio.py setup
    # The same uv-managed render/PyMOL environments serve local CLI and Slurm jobs.
    # No dependency resolution, installation or environment copy happens at runtime.
    /opt/studio-runtime/render/bin/python -m blender_render.cluster.worker --check
    rm -rf /var/lib/apt/lists/* /opt/studio-runtime/uv-cache

%environment
    export PATH=/opt/studio-runtime/render/bin:/opt/studio-runtime/bin:/opt/uv-tool/bin:$PATH
    export STRUCTURE_STUDIO_HOME=/opt/studio-runtime
    export BLENDER_RENDER_HOME=/opt/studio-runtime/blender-render
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec /opt/studio-runtime/render/bin/blender-render "$@"

%test
    /opt/studio-runtime/render/bin/blender-render --version
    /opt/studio-runtime/pymol/bin/python -c 'import pymol2'
    /opt/studio-runtime/render/bin/python -m blender_render.cluster.worker --check
