Bootstrap: localimage
From: {{ BASE_IMAGE }}

# Refresh an already validated Linux image when only application source changes.
# Verify BASE_IMAGE's recorded SHA-256 before building. Changed dependency pins
# require a full build with Apptainer.def instead. No environment is relocated.
%arguments
    BASE_IMAGE=renderer-base.sif
    RELEASE_DIR=dist/release

%files
    {{ RELEASE_DIR }}/plugin/molblender-studio /opt/molblender-studio-next
    {{ RELEASE_DIR }}/release.json /opt/release-next.json

%post
    set -eu
    for component in render pymol; do
        cmp /opt/molblender-studio/skills/molblender-studio/references/$component-requirements.txt \
            /opt/molblender-studio-next/skills/molblender-studio/references/$component-requirements.txt
    done
    rm -rf /opt/molblender-studio
    mv /opt/molblender-studio-next /opt/molblender-studio
    mv /opt/release-next.json /opt/release.json
    export PATH=/opt/uv-tool/bin:$PATH
    export MOLBLENDER_STUDIO_HOME=/opt/studio-runtime
    export MOL_BLENDER_HOME=/opt/studio-runtime/mol-blender
    export UV_OFFLINE=1
    # uv sync needs registry metadata even when every dependency is installed.
    # The base image intentionally drops its cache. Check the complete runtime
    # contract and install only the new local wheel, without resolving packages.
    /opt/studio-runtime/render/bin/python - <<'PY'
import hashlib, json, pathlib, subprocess, sys, sysconfig, zipfile
wheels = list(pathlib.Path('/opt/molblender-studio/skills/molblender-studio/assets/wheels').glob('*.whl'))
assert len(wheels) == 1
wheel = wheels[0]
old = pathlib.Path(sysconfig.get_paths()['purelib']) / 'mol_blender/engine-manifest.json'
with zipfile.ZipFile(wheel) as archive:
    manifest = json.loads(archive.read('mol_blender/engine-manifest.json'))
assert manifest['runtime_requirements'] == json.loads(old.read_text())['runtime_requirements'], 'Runtime pins changed; use a full build'
subprocess.run(['/opt/uv-tool/bin/uv', 'pip', 'install', '--offline', '--no-deps',
                '--python', sys.executable, str(wheel)], check=True)
state_path = pathlib.Path('/opt/studio-runtime/state.json')
state = json.loads(state_path.read_text())
state['wheel_sha256'] = hashlib.sha256(wheel.read_bytes()).hexdigest()
state_path.write_text(json.dumps(state, indent=2) + '\n')
PY
    /opt/studio-runtime/render/bin/python -m mol_blender.cluster.worker --check

%test
    /opt/studio-runtime/render/bin/mol-blender --version
    /opt/studio-runtime/pymol/bin/python -c 'import pymol2'
    /opt/studio-runtime/render/bin/python -m mol_blender.cluster.worker --check
