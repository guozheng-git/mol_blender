{
  "kind": "hpc",
  "transport": "slurm",
  "host": "YOUR_SSH_ALIAS",
  "remote_python": "/shared/path/blender-render/.venv/bin/python",
  "remote_root": "/shared/path/blender-render",
  "image": "/shared/path/blender-render-0.2.0b1.sif",
  "registry": "/shared/path/blender-render-session",
  "version": 2,
  "launcher": {
    "kind": "slurm_sbatch",
    "arguments": [
      "--partition=gpu",
      "--gres=gpu:1",
      "--mem=64G",
      "--cpus-per-task=4",
      "--time=00:30:00"
    ]
  }
}
