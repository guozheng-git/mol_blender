Bootstrap: docker
From: python@sha256:78b39ef14d8e2b4d71f8dc304f1328c37df95fe0ef99477c2ae6bd3d03784553

%labels
    org.opencontainers.image.title "Blender Render"
    org.opencontainers.image.version "0.2.0b1"
    org.opencontainers.image.source "https://github.com/magnusbauer/blender_render"
    org.opencontainers.image.licenses "MIT AND GPL-3.0-or-later"

%files
    blender_render /opt/blender_render
    LICENSE /opt/LICENSE
    THIRD_PARTY_NOTICES.md /opt/THIRD_PARTY_NOTICES.md
    containers/runtime-install.sh /opt/runtime-install.sh

%post
    sh /opt/runtime-install.sh

%environment
    export PYTHONPATH=/opt:/opt/runtime/site
    export BLENDER_RENDER_SITE=/opt/runtime/site
    export PYTHONUNBUFFERED=1
    export QT_QPA_PLATFORM=offscreen

%runscript
    exec python -m blender_render.cli "$@"

%test
    blender --background --python-use-system-env --python-exit-code 1 --python /opt/blender_render/runtime_initialize.py

%help
    Build from the source repository root:
      apptainer build blender-render-0.2.0b1-linux-x64.sif blender_render/blender_bridge.def

    Run the pinned worker:
      apptainer run --nv blender-render-0.2.0b1-linux-x64.sif serve --token-file /path/to/token

    Dependency notices are in /usr/share/doc and /opt/notices. Corresponding
    sources and build instructions accompany the release.
