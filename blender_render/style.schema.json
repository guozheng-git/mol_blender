{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pymol-blender-bridge/style.schema.json",
  "title": "PyMOL Blender Bridge Full Custom Style",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "output",
    "renderer",
    "camera",
    "world",
    "lights",
    "materials",
    "styles"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version string, for example 1.0"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "width",
        "height",
        "samples"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "PNG",
            "JPEG",
            "TIFF",
            "OPEN_EXR"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "save_blend": {
          "type": "boolean"
        },
        "blend_filename": {
          "type": "string",
          "minLength": 1
        },
        "raw_view": {
          "type": "boolean"
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "CYCLES",
            "BLENDER_EEVEE",
            "EEVEE"
          ]
        },
        "device": {
          "type": "string",
          "enum": [
            "GPU",
            "CPU"
          ]
        },
        "compute_device_type": {
          "type": "string"
        },
        "transparent_background": {
          "type": "boolean"
        },
        "adaptive_sampling": {
          "type": "boolean"
        },
        "require_gpu": {
          "type": "boolean"
        },
        "exposure": {
          "type": "number"
        },
        "gamma": {
          "type": "number",
          "minimum": 0.01
        },
        "view_transform": {
          "type": "string"
        },
        "look": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "denoise": {
          "type": "boolean"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "pymol",
            "override"
          ]
        },
        "lens_mm": {
          "type": "number"
        },
        "shift_x": {
          "type": "number"
        },
        "shift_y": {
          "type": "number"
        },
        "world_scale": {
          "type": "number",
          "minimum": 0
        },
        "anchor_model_center": {
          "type": "boolean"
        },
        "override_intrinsics": {
          "type": "boolean"
        },
        "direction_source": {
          "type": "string",
          "enum": [
            "preset",
            "pymol"
          ]
        },
        "yaw_offset_deg": {
          "type": "number"
        },
        "pitch_offset_deg": {
          "type": "number"
        },
        "yaw_deg": {
          "type": "number"
        },
        "pitch_deg": {
          "type": "number"
        },
        "distance_scale": {
          "type": "number",
          "minimum": 0
        },
        "focus_style": {
          "type": "string"
        },
        "clip_start": {
          "type": "number",
          "minimum": 0
        },
        "clip_end": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background_type": {
          "type": "string",
          "enum": [
            "solid",
            "gradient"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "top_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "bottom_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "lights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "energy"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "AREA",
              "SUN",
              "POINT",
              "SPOT"
            ]
          },
          "energy": {
            "type": "number"
          },
          "size": {
            "type": "number",
            "minimum": 0
          },
          "size_scale": {
            "type": "number",
            "minimum": 0
          },
          "min_size": {
            "type": "number",
            "minimum": 0
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "location": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotation_deg": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "relative_vector": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "distance_scale": {
            "type": "number",
            "minimum": 0
          },
          "look_at_target": {
            "type": "boolean"
          },
          "rotate_with_pymol_yaw": {
            "type": "boolean"
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "shadow_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "highlight_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "specular": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "transmission": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emission_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "emission_strength": {
            "type": "number",
            "minimum": 0
          },
          "ao_strength": {
            "type": "number",
            "minimum": 0
          },
          "rim_strength": {
            "type": "number",
            "minimum": 0
          },
          "rim_blend": {
            "type": "number",
            "minimum": 0
          },
          "rim_power": {
            "type": "number",
            "minimum": 0
          },
          "ao_distance": {
            "type": "number",
            "minimum": 0
          },
          "coat": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "style",
          "selection",
          "material"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "type": "string",
            "enum": [
              "surface",
              "cartoon",
              "sticks",
              "spheres",
              "ribbon",
              "wire"
            ]
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string"
          },
          "selection": {
            "$ref": "#/$defs/selectionDsl"
          },
          "fallback_selection": {
            "$ref": "#/$defs/selectionDsl"
          },
          "radius": {
            "type": "number",
            "minimum": 0
          },
          "quality": {
            "type": "number",
            "minimum": 0
          },
          "probe_radius": {
            "type": "number",
            "minimum": 0
          },
          "subdivisions": {
            "type": "integer",
            "minimum": 0
          },
          "thickness": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "loop_radius": {
            "type": "number",
            "minimum": 0
          },
          "shade_smooth": {
            "type": "boolean"
          },
          "peptide_cylinders": {
            "type": "boolean"
          },
          "peptide_rounded": {
            "type": "boolean"
          },
          "peptide_smoothing": {
            "type": "number",
            "minimum": 0
          },
          "nucleic_thickness": {
            "type": "number",
            "minimum": 0
          },
          "nucleic_width": {
            "type": "number",
            "minimum": 0
          },
          "nucleic_radius": {
            "type": "number",
            "minimum": 0
          },
          "backbone_shape": {
            "type": "string"
          },
          "base_shape": {
            "type": "string"
          },
          "base_realize": {
            "type": "boolean"
          },
          "color_blur": {
            "type": "boolean"
          },
          "sticks_radius": {
            "type": "number",
            "minimum": 0
          },
          "sticks_quality": {
            "type": "number",
            "minimum": 0
          },
          "sticks_shade_smooth": {
            "type": "boolean"
          },
          "ligand_cutout_radius": {
            "type": "number",
            "minimum": 0
          },
          "ligand_cutout_offset": {
            "type": "number"
          },
          "ligand_cutout_auto_side": {
            "type": "boolean"
          },
          "ligand_cutout_axis_mode": {
            "type": "string",
            "enum": [
              "interface",
              "camera"
            ]
          },
          "ligand_cutout_flatten_z": {
            "type": "boolean"
          },
          "ligand_cutout_width_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_depth_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_height_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_one_sided": {
            "type": "boolean"
          },
          "ligand_cutout_one_sided_shift_scale": {
            "type": "number",
            "minimum": 0
          },
          "ligand_cutout_cap_mode": {
            "type": "string",
            "enum": [
              "panel",
              "none"
            ]
          },
          "ligand_cutout_selection": {
            "type": "boolean"
          },
          "ligand_cutout_mirror": {
            "type": "boolean"
          },
          "ligand_cutout_isolate": {
            "type": "boolean"
          },
          "del_solvent": {
            "type": "boolean"
          }
        }
      }
    },
    "color_follow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "chain",
            "class"
          ]
        },
        "mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "saturation_boost": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "value_boost": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "selectionDsl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polymer": {
          "type": "boolean"
        },
        "nucleic": {
          "type": "boolean"
        },
        "ligand": {
          "type": "boolean"
        },
        "chain": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "residue_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "query": {
          "type": "string"
        },
        "within_ligand_radius": {
          "type": "number",
          "minimum": 0
        },
        "exclude_within_ligand_radius": {
          "type": "number",
          "minimum": 0
        },
        "expand_to_residue": {
          "type": "boolean"
        }
      }
    }
  }
}
