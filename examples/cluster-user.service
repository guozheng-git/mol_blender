[Unit]
Description=mol-blender shared Slurm gateway
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/mol-blender-cluster
ExecStart=%h/mol-blender-cluster/controller/bin/mol-blender cluster serve --config %h/.config/mol-blender-cluster/server.json --bind @CLUSTER_ADDRESS@ --port @PORT@ --tls-cert %h/.config/mol-blender-cluster/server.crt --tls-key %h/.config/mol-blender-cluster/server.key
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s

[Install]
WantedBy=default.target
